# The Mercure hub built into this image, for `make test-security-mercure`, set
# up as examples/mercure-local-hub/Caddyfile is, with 127.0.0.1:8090 standing
# in for the site's public address: one site block, the app and its hub on the
# public address, the hub alone on 127.0.0.2 for scripts. Plain HTTP, Mercure
# 1.0, and the subscriptions API so the test can see which subscriptions are
# open.
{
	frankenphp
	admin off
	auto_https off
	skip_install_trust
}

http://127.0.0.1:8090, http://127.0.0.2:8090 {
	root * /app/tests/web

	mercure {
		issuer https://localhost {
			publisher {
				jwt "frankenscriptling-mercure-test-key-0123456789" HS256
			}
			subscriber {
				jwt "frankenscriptling-mercure-test-key-0123456789" HS256
			}
		}
		resource_identifier http://127.0.0.1:8090/.well-known/mercure
		subscriptions
	}

	@scripts {
		host 127.0.0.2
		not path /.well-known/mercure /.well-known/mercure/*
	}
	respond @scripts 404

	php_server
}
