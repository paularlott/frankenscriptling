# Build through the Makefile (make all / make dev): it sets every ARG below
# from one place. The defaults only keep a bare `docker build .` working.
ARG FRANKENPHP_VERSION=1.13.2
ARG PHP_VERSION=8.5.12
ARG GO_MODULE=example.com/frankenscriptling
ARG SCRIPTLING_VERSION=v0.33.0
ARG IMAGE_VERSION=0.0.0-dev
ARG IMAGE_REVISION=unknown

FROM dunglas/frankenphp:${FRANKENPHP_VERSION}-builder-php${PHP_VERSION} AS builder

ARG FRANKENPHP_VERSION=1.13.2
ARG PHP_VERSION=8.5.12
ARG GO_MODULE=example.com/frankenscriptling
ARG SCRIPTLING_VERSION=v0.33.0
ARG IMAGE_VERSION=0.0.0-dev
ARG IMAGE_REVISION=unknown

COPY --from=caddy:builder /usr/bin/xcaddy /usr/bin/xcaddy

WORKDIR /app

COPY scriptling_ext.go security.go ./

# buildinfo.go carries the versions Scriptling::getBuildInfo() reports; the
# checked-in copy holds dev placeholders, this one the real build.
RUN printf 'package frankenscriptling\n\n// Code generated by the Dockerfile; DO NOT EDIT.\n\nconst (\n\timageVersion      = "%s"\n\timageRevision     = "%s"\n\tfrankenPHPVersion = "%s"\n\tphpBuildVersion   = "%s"\n)\n' \
    "${IMAGE_VERSION}" "${IMAGE_REVISION}" "${FRANKENPHP_VERSION}" "${PHP_VERSION}" > buildinfo.go

ENV GOTOOLCHAIN=auto

RUN go mod init ${GO_MODULE} \
    && go get github.com/dunglas/frankenphp@v${FRANKENPHP_VERSION} \
    && go get github.com/paularlott/scriptling@${SCRIPTLING_VERSION} \
    && go mod tidy

# FrankenPHP bug (https://github.com/php/frankenphp/issues/2572): Go extensions
# are only registered on the first PHP startup. register_internal_extensions()
# frees its module list afterwards, so a config reload (admin API /load,
# caddy-scaleout, --watch) restarts PHP without the Scriptling class. Build
# against a copy that keeps the list so every startup registers it again. When
# upstream changes this code the patch no longer applies and the build says so.
RUN cp -r "$(go env GOMODCACHE)/github.com/dunglas/frankenphp@v${FRANKENPHP_VERSION}" /frankenphp-src \
    && chmod -R u+w /frankenphp-src \
    && perl -0pi -e 's/\n  pefree\(modules, 1\);\n  modules = NULL;\n  modules_len = 0;\n\n  return SUCCESS;/\n  return SUCCESS;/ or die "frankenphp.c: extension registration patch did not apply\n"' /frankenphp-src/frankenphp.c

ADD https://www.php.net/distributions/php-${PHP_VERSION}.tar.gz /tmp/php.tar.gz
RUN tar xzf /tmp/php.tar.gz -C /tmp

RUN GEN_STUB_SCRIPT=/tmp/php-${PHP_VERSION}/build/gen_stub.php \
    frankenphp extension-init scriptling_ext.go

# Everything above is the prepared extension source; the builder target stops
# here and is published as <version>-php<php>-builder, so downstream images can
# run build-frankenscriptling with extra Caddy modules (see that script).
ENV FRANKENSCRIPTLING_FRANKENPHP_VERSION=${FRANKENPHP_VERSION} \
    FRANKENSCRIPTLING_GO_MODULE=${GO_MODULE} \
    FRANKENSCRIPTLING_SRC=/app

COPY --chmod=0755 build-frankenscriptling /usr/local/bin/build-frankenscriptling

FROM builder AS build

RUN build-frankenscriptling

# Test-only: real, already-tested scriptling plugin binaries, built as
# fixtures for the security-policy plugin tests (make build-test-plugin).
# Three binaries: the original stdio fixture (directory-scanned by
# SCRIPTLING_PLUGIN_DIR in most tests), a second, distinctly-named stdio
# fixture (loaded via an explicit SCRIPTLING_PLUGIN path, to prove the two
# env vars combine), and an HTTP-mode fixture (a real http(s) JSON-RPC
# endpoint, for SCRIPTLING_PLUGIN=http(s)://... and for a script-initiated
# load() the network policy actually allows). The HTTP fixture is exported
# to its own directory, never the one SCRIPTLING_PLUGIN_DIR scans — a
# directory scan spawns every executable it finds as a stdio JSON-RPC peer,
# and this one is an HTTP listener, not a stdio peer.
# Sits between builder and runtime deliberately — the LAST stage in this
# file is what a target-less build (`docker build .` / bake with no
# `target` field) produces, and that must always be `runtime` below, never
# this test-only one.
FROM builder AS test-plugin
ARG SCRIPTLING_VERSION=v0.33.0
COPY tests/fixtures/plugin-src/ /test-plugin-src/
RUN cd /test-plugin-src \
    && go mod init frankenscriptling-test-plugin \
    && go get github.com/paularlott/scriptling@${SCRIPTLING_VERSION} \
    && go mod tidy \
    && mkdir -p /out/plugins /out/plugins-explicit /out/plugins-http \
    && CGO_ENABLED=0 go build -o /out/plugins/test-plugin . \
    && CGO_ENABLED=0 go build -o /out/plugins-explicit/second-plugin ./second-plugin \
    && CGO_ENABLED=0 go build -o /out/plugins-http/http-plugin ./http-plugin

FROM scratch AS test-plugin-export
COPY --from=test-plugin /out/plugins/test-plugin /plugins/test-plugin
COPY --from=test-plugin /out/plugins-explicit/second-plugin /plugins-explicit/second-plugin
COPY --from=test-plugin /out/plugins-http/http-plugin /plugins-http/http-plugin

# PHP from the official FrankenPHP image with our binary in place of its own.
# The runtime copies /usr/local and /usr/src from here onto a bare
# trixie-slim, which leaves out the compiler toolchain the official image keeps
# (~350MB) and its original FrankenPHP binary. setcap here: COPY keeps the
# capability, so the runtime needs no extra layer for it.
FROM dunglas/frankenphp:${FRANKENPHP_VERSION}-php${PHP_VERSION} AS php

COPY --from=build /usr/local/bin/frankenphp /usr/local/bin/frankenphp
COPY --chmod=0755 php-ext-toolchain /usr/local/libexec/frankenscriptling/php-ext-toolchain

RUN set -eux; \
    setcap cap_net_bind_service=+ep /usr/local/bin/frankenphp; \
    \
    # The extension scripts get the toolchain themselves (see php-ext-toolchain)
    for f in docker-php-ext-configure docker-php-ext-install docker-php-ext-enable install-php-extensions; do \
        mv "/usr/local/bin/$f" "/usr/local/libexec/frankenscriptling/$f"; \
        ln -s ../libexec/frankenscriptling/php-ext-toolchain "/usr/local/bin/$f"; \
    done; \
    \
    # The Debian packages PHP, its extensions and FrankenPHP link against
    find /usr/local -type f \( -name '*.so' -o -name '*.so.*' -o -perm /0111 \) -exec ldd '{}' ';' 2> /dev/null \
        | awk '/=>/ { so = $(NF-1); if (index(so, "/usr/local/") == 1) next; print so }' \
        | sort -u \
        | xargs -r -n1 readlink -f \
        | xargs -r dpkg-query --search 2> /dev/null \
        | grep -v '^diversion' \
        | cut -d: -f1 \
        | sort -u > /runtime-packages; \
    cat /runtime-packages

FROM debian:trixie-slim AS runtime

ARG PHP_VERSION=8.5.12

# As the official PHP / FrankenPHP images
ENV PHPIZE_DEPS="autoconf dpkg-dev file g++ gcc libc-dev make pkg-config re2c" \
    PHP_INI_DIR=/usr/local/etc/php \
    PHP_VERSION=${PHP_VERSION} \
    PHP_CFLAGS="-fstack-protector-strong -fpic -fpie -O2 -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64" \
    PHP_CPPFLAGS="-fstack-protector-strong -fpic -fpie -O2 -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64" \
    PHP_LDFLAGS="-Wl,-O1 -pie" \
    XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data \
    GODEBUG=cgocheck=0

COPY --from=php /runtime-packages /tmp/runtime-packages

RUN set -eux; \
    # Debian's own PHP packages must never replace this PHP
    { echo 'Package: php*'; echo 'Pin: release *'; echo 'Pin-Priority: -1'; } > /etc/apt/preferences.d/no-debian-php; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates curl xz-utils mailcap libcap2-bin procps vim-tiny \
        $(cat /tmp/runtime-packages); \
    rm -rf /var/lib/apt/lists/* /tmp/runtime-packages; \
    mkdir -p /var/www/html /app/public /config/caddy /data/caddy /etc/caddy /etc/frankenphp; \
    chown www-data:www-data /var/www/html; \
    chmod 1777 /var/www/html; \
    # Writable by www-data so FrankenPHP can run as non-root
    chown -R www-data:www-data /config /data

COPY --from=php /usr/local /usr/local
# PHP source: docker-php-ext-install builds core extensions (gd, mysqli, …) from it
COPY --from=php /usr/src /usr/src
COPY Caddyfile /etc/frankenphp/Caddyfile

# CVE-2026-115560: disable session upload progress tracking. In conf.d as
# zz-security.ini so it loads after every other ini file and an image's own
# php.ini or a mounted custom.ini cannot turn it back on. Covers the official
# image layout ($PHP_INI_DIR) and Debian/Ubuntu PHP packages (/etc/php).
RUN set -e; written=0; \
    for d in "${PHP_INI_DIR:-/usr/local/etc/php}/conf.d" /etc/php/*/*/conf.d; do \
      [ -d "$d" ] || continue; \
      printf '%s\n' '; CVE-2026-115560' 'session.upload_progress.enabled = 0' > "$d/zz-security.ini"; \
      written=$((written + 1)); \
    done; \
    [ "$written" -gt 0 ]

RUN ldconfig

WORKDIR /app

EXPOSE 80 443 443/udp 2019

HEALTHCHECK CMD curl -f http://localhost:2019/metrics || exit 1

ENTRYPOINT ["docker-php-entrypoint"]
CMD ["--config", "/etc/frankenphp/Caddyfile", "--adapter", "caddyfile"]
